{
  "name": "aha-obsidian-plugin",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Obsidian memory surface for Aha insight review.",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "npm --prefix .. test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:e2e:real": "npm --prefix .. run test:e2e:real"
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^25.0.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0"
  }
}
